{
  "name": "grindlog",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/server/main.ts",
    "dev": "GRINDLOG_DATA_DIR=.dev-data GRINDLOG_PORT=49101 bun run src/server/main.ts",
    "stop": "bun run scripts/stop.ts",
    "recompute": "bun run scripts/recompute.ts",
    "rules-diff": "bun run scripts/rules-diff.ts",
    "move-data": "bun run scripts/move-data.ts",
    "screens-data": "bun run scripts/screens-data.ts",
    "definitions": "bun run scripts/definitions.ts",
    "icons": "bun run scripts/make-icons.ts",
    "deploy": "bun run check && bun run e2e && bun run install-autostart && bun run recompute",
    "install-autostart": "bun run scripts/autostart.ts install",
    "uninstall-autostart": "bun run scripts/autostart.ts uninstall",
    "build-release": "bun run scripts/build-release.ts",
    "sign-release": "bun run scripts/sign-release.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "e2e": "vite build && playwright test",
    "site:screens": "GRINDLOG_CHANNEL=prod vite build && playwright test -c playwright.site.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web && tsc --noEmit -p tsconfig.site.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun --bun vitest run",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.1",
    "html-to-image": "1.11.11",
    "lucide-react": "1.72.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.3",
    "vitest": "^5.0.5"
  }
}
